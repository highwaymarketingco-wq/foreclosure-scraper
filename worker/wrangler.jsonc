// worker/wrangler.jsonc  (template)
//
// You normally do not edit this file. scripts/deploy_worker.sh reads
// worker/deploy.conf, writes worker/wrangler.rendered.jsonc with your account,
// URL and Access values filled in, and runs `wrangler deploy` on that. Deployed
// as-is, this template is safe: it has no public URL, and the placeholder Access
// values make the Worker answer 503 to every request.
//
// Config keys checked against
// https://developers.cloudflare.com/workers/wrangler/configuration/ (2026-09-21).
{
  "name": "foreclosure-board",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // The default *.workers.dev address is NOT exposed (Cloudflare's default is
  // true). The rendered config turns it on only if you choose URL_MODE=workers-dev
  // in deploy.conf, and preview URLs stay off either way.
  "workers_dev": false,
  "preview_urls": false,

  // Your own domain (must already be on Cloudflare). Fill in via WORKER_HOSTNAME
  // in deploy.conf; the rendered config adds it in this form:
  // "routes": [{ "pattern": "board.example.com", "custom_domain": true }],

  // App shell: about 0.45 MiB built by worker/scripts/build_shell.mjs.
  // run_worker_first is REQUIRED: without it the platform serves these files
  // without running any Worker code, which would skip the Access token check.
  // The 84 MiB board cannot live here (25 MiB per asset); it streams from R2.
  "assets": {
    "directory": "./shell",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Private bucket. Never give it a public r2.dev URL or a custom domain.
  "r2_buckets": [{ "binding": "BOARD", "bucket_name": "foreclosure-board" }],

  "vars": {
    // From Zero Trust: your team name, e.g. "acme" or "acme.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    // From the Access application for this Worker: "Application Audience (AUD) Tag".
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG",
    // Only "false" on localhost (wrangler dev). Refused on any other host.
    "ACCESS_ENFORCE": "true",
    // Also accept ctx.access (set by the runtime when Access authenticated the request).
    "ACCESS_ACCEPT_CTX": "true",
    // Seconds the Worker remembers current.json (0 to 300).
    "POINTER_TTL_SECONDS": "30",
    // Break-glass: "true" adds 'unsafe-inline' to script-src if the page breaks under the strict CSP.
    "CSP_RELAXED": "false",
    // "true" adds an X-Auth-Deny header naming why a request was refused. Leave off.
    "AUTH_DEBUG": "false"
  },

  // Minimal: sampled logs only. The Worker logs a reason code for refusals and
  // never logs paths, emails or tokens.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
