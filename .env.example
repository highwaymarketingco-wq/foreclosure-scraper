# Copy to .env for local runs. NEVER commit the actual .env file.
# In GitHub Actions these come from repo Secrets, not this file.

# Google Sheets (service account JSON, paste the whole single-line JSON value)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Target Google Sheet ID (the long string in the Sheet URL between /d/ and /edit)
SHEET_ID=

# Email recipients (comma-separated)
EMAIL_RECIPIENTS=greghhigh@gmail.com,cashrandolphhigh@gmail.com

# Gmail SMTP sender + app password (16-char password from Google account security)
GMAIL_SENDER=greghhigh@gmail.com
GMAIL_APP_PASSWORD=

# This tool is 100% free — no Apify, no proxies, no paid services.
# JS-rendered / anti-bot sites are handled by the local stealth browser
# (Scrapling/camoufox). Run locally, not on headless CI, for best results.
