<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily REO/API refresh, then vision. 09:30 (unchanged). After scripts patches (docs/ops_fixes_2026-09-21.md O2/O6) it no longer skips Tue/Fri and vision is time-boxed to 90 minutes.
     TEMPLATE: the two double-underscore placeholders in the paths are filled in by scripts/install_launchd.sh. Nothing here
     is installed or loaded until that script is run with its apply option. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.highway.foreclosure.dailyvision</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__ROOT__/scripts/run_daily_vision.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>BOARD_MEM_GATE</key>
		<string>warn</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>__ROOT__/logs/dailyvision.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__ROOT__/logs/dailyvision.launchd.log</string>
	<key>WorkingDirectory</key>
	<string>__ROOT__</string>
</dict>
</plist>
